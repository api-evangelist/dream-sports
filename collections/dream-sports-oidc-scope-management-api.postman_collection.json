        {
          "id": "61087427-2347-4002-a0fb-a0f619891478",
          "name": "Delete a scope",
          "request": {
            "name": "Delete a scope",
            "description": {
              "content": "Delete a specific scope by name. This operation is irreversible and will \nremove all associations with this scope.\n\n**Important:** Deleting a scope that is currently in use by applications \nor users may cause authentication and authorization issues.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "scopes",
                ":name"
              ],
