                  "key": "name",
                  "value": "<string>",
                  "description": "Filter scopes by name (partial match, case-insensitive)"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number for pagination"
                },
                {
                  "disabled": false,
                  "key": "page_size",
