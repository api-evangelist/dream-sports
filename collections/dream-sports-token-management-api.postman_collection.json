        {
          "id": "d8420c0f-3cb8-4eba-825d-89536608a43f",
          "name": "Get token revocation list",
          "request": {
            "name": "Get token revocation list",
            "description": {
              "content": "Retrieve the list of revoked tokens for the tenant within a time range.\n\nThis endpoint provides information about tokens that have been revoked\nbetween the specified time range. If no 'from' timestamp is provided,\nit defaults to current time minus access token expiry duration.\n\n**Time Range Logic:**\n- The endpoint automatically calculates the 'to' timestamp as the current time\n- If 'from' is not provided, it defaults to current time minus access token expiry\n- If 'from' is before the allowed range, it gets adjusted to the minimum allowed time\n- If 'from' is in the future, an error is returned\n\n**Response:**\n- Returns a list of revoked token identifiers (strings)\n- Includes the actual time range used for the query\n- Includes the access token expiry duration for reference\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "revocations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<long>",
                  "description": "Start timestamp (epoch seconds). If not provided, defaults to current time minus access token expiry"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) tenant-id of the client integrating with guardian",
                "key": "tenant-id",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "fa47dd1a-9311-4cb7-b42b-db056c74f3a5",
              "name": "Revocation list retrieved successfully",
              "originalRequest": {
