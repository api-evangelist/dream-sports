{
  "opencollection": "1.0.0",
  "info": {
    "name": "Delivr OTA Server Metrics API"
  },
  "items": [
    {
      "info": {
        "name": "Metrics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get deployment metrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/apps/:appName/deployments/:deploymentName/metrics",
            "headers": [
              {
                "name": "tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "appName",
                "value": "MyApp-iOS",
                "type": "path",
                "description": "Application name (or 'owner:appName' for disambiguation)"
              },
              {
                "name": "deploymentName",
                "value": "Production",
                "type": "path",
                "description": "Deployment environment name"
              }
            ]
          },
          "docs": "Returns installation and usage metrics for a deployment"
        }
      ]
    }
  ],
  "bundled": true
}