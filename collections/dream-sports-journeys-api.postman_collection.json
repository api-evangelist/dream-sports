          "id": "ede4994d-3f50-483e-b13b-61ba70354961",
          "name": "Create Journey",
          "request": {
            "name": "Create Journey",
            "description": {
              "content": "Creates a new journey in DRAFT status.\n\n**Important**:\n- `startTime` and `endTime` must be future timestamps (milliseconds)\n- `stateMachineTTL` must be a future timestamp\n- Use `cohortEligibility: { includes: [\"all\"], excludes: [] }`\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "thunder",
                "ctas"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) ",
                "key": "USER-ID",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"<string>\",\n  \"team\": \"<string>\",\n  \"rule\": {\n    \"cohortEligibility\": {\n      \"includes\": [\n        \"<string>\",\n        \"<string>\"\n      ],\n      \"excludes\": [\n        \"<string>\",\n        \"<string>\"\n      ]\n    },\n    \"stateToAction\": {\n      \"key_0\": \"<string>\",\n      \"key_1\": \"<string>\",\n      \"key_2\": \"<string>\",\n      \"key_3\": \"<string>\"\n    },\n    \"stateTransition\": \"<object>\",\n    \"priority\": \"<integer>\",\n    \"stateMachineTTL\": \"<long>\",\n    \"actions\": [\n      \"<object>\",\n      \"<object>\"\n    ],\n    \"frequency\": {\n      \"session\": {\n        \"limit\": \"<integer>\"\n      },\n      \"window\": {\n        \"limit\": \"<integer>\",\n        \"unit\": \"<string>\",\n        \"value\": \"<integer>\"\n      }\n    },\n    \"resetStates\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"contextParams\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"groupByConfig\": \"<object>\"\n  },\n  \"tags\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"description\": \"<string>\",\n  \"startTime\": \"<long>\",\n  \"endTime\": \"<long>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "959198d6-1e5c-4e7b-8b6e-9b8611cac688",
              "name": "Journey created",
