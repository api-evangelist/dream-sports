        {
          "id": "f00d500f-42bc-4c93-8753-03bbddcede88",
          "name": "Request authentication challenge",
          "request": {
            "name": "Request authentication challenge",
            "description": {
              "content": "Generate a random challenge (nonce) for biometric authentication.\n\n## Process\n1. Client requests a challenge\n2. Server generates a cryptographically secure 32-byte random nonce\n3. Server stores the challenge with a 5-minute expiry and generates a state\n4. Client receives the challenge and state\n5. Client uses the state for subsequent complete operations\n\n## Challenge Properties\n- **Size**: 32 bytes (256 bits)\n- **Encoding**: Base64\n- **Expiry**: 5 minutes (300 seconds)\n- **Single-use**: Can only be used once for authentication\n\n## State Properties\n- **Single-use**: State can only be used once\n- **Expiry**: State expires with the challenge (5 minutes)\n- **Required**: State must be provided in complete requests\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "biometric",
                "challenge"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) tenant-id of the client integrating with guardian",
                "key": "tenant-id",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"<string>\",\n  \"client_id\": \"<string>\",\n  \"device_metadata\": {\n    \"device_id\": \"<string>\",\n    \"platform\": \"<string>\",\n    \"device_model\": \"<string>\",\n    \"os_version\": \"<string>\",\n    \"app_version\": \"<string>\",\n    \"device_name\": \"<string>\"\n  }\n}",
