          "name": "Get OpenID Connect Discovery Configuration",
          "request": {
            "name": "Get OpenID Connect Discovery Configuration",
            "description": {
              "content": "Returns the OpenID Connect discovery configuration for the tenant.\n\nThis endpoint provides metadata about the OpenID Connect implementation,\nincluding supported endpoints, grant types, response types, scopes, and claims.\n\nThe configuration follows the OpenID Connect Discovery 1.0 specification\n(https://openid.net/specs/openid-connect-discovery-1_0.html).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ".well-known",
                "openid-configuration"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) tenant-id of the client integrating with guardian",
                "key": "tenant-id",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
