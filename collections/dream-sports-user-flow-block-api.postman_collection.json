        {
          "id": "0a6348bb-ac65-4a8d-b39a-19d4773a7168",
          "name": "Unblock user flows",
          "request": {
            "name": "Unblock user flows",
            "description": {
              "content": "API to unblock previously blocked authentication flows for a user identifier.\nThis allows the user to use the specified authentication methods again.\nFor password/PIN block (wrong attempts from signin or MFA signin), use unblockFlows\n[\"password\"] and/or [\"pin\"] to unblock. user_identifier must be the username, email, or\nphone number (the identifier used when signing in) for password/PIN blocks. Lifts the\nblock before the block interval expires (e.g. after reset).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "user",
                "flow",
                "unblock"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) tenant-id of the client integrating with guardian",
