                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userIdentifier\": \"<string>\",\n  \"unblockFlows\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
