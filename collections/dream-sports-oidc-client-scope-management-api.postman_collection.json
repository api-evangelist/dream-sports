        {
          "id": "9007f4f1-6dc9-44bb-8679-abbd05cafd0a",
          "name": "Remove scope from client",
          "request": {
            "name": "Remove scope from client",
            "description": {
              "content": "Remove a specific scope from an OAuth 2.0 client.\n\n**Impact:**\n- The client will no longer be able to request this scope\n- Existing tokens with this scope remain valid until expiration\n- New authorization requests will not include this scope\n\n**Validation:**\n- The scope must be currently assigned to the client\n- If the scope is not assigned, the operation succeeds (idempotent)\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "admin",
                "client",
                ":client_id",
                "scope"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "(Required) Name of the scope to remove"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "client_id",
                  "description": "(Required) Unique identifier of the client"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) tenant-id of the client integrating with guardian",
                "key": "tenant-id",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "DELETE",
            "auth": null
          },
          "response": [
            {
              "id": "4955e2e2-cb60-402e-88ee-bcdfc9e29a48",
              "name": "Scope removed successfully",
