        {
          "id": "5768f62b-e560-4ea9-826f-aa2b59d63dde",
          "name": "Add scopes to client",
          "request": {
            "name": "Add scopes to client",
            "description": {
              "content": "Add one or more scopes to an OAuth 2.0 client. This allows the client\nto request these scopes during the authorization flow.\n\n**Scope Validation:**\n- All scopes must exist in the tenant\n- Duplicate scopes are automatically ignored\n- Invalid scopes are filtered out\n\n**Batch Operation:**\n- Multiple scopes can be added in a single request\n- The operation is atomic - either all valid scopes are added or none\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "admin",
                "client",
                ":client_id",
                "scope"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "client_id",
                  "description": "(Required) Unique identifier of the client"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) tenant-id of the client integrating with guardian",
                "key": "tenant-id",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scopes\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
