      "name": "Journey Lifecycle",
      "description": {
        "content": "Journey lifecycle status transitions.\nJourneys move through states: DRAFT -> SCHEDULED -> LIVE -> PAUSED -> CONCLUDED/TERMINATED.\nEach status transition has its own dedicated endpoint.\n",
        "type": "text/plain"
      },
