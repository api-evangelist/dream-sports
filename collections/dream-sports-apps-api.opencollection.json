{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dream Sports Apps API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Apps",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List apps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:3000/apps",
            "headers": [
              {
                "name": "tenant",
                "value": ""
              }
            ]
          },
          "docs": "Returns all apps accessible by the authenticated account"
        },
        {
          "info": {
            "name": "Create app",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:3000/apps",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new application"
        },
        {
          "info": {
            "name": "Get app",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:3000/apps/:appName",
            "headers": [
              {
                "name": "tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "appName",
                "value": "MyApp-iOS",
                "type": "path",
                "description": "Application name (or 'owner:appName' for disambiguation)"
              }
            ]
          },
          "docs": "Returns details of a specific app"
        },
        {
          "info": {
            "name": "Update app",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "http://localhost:3000/apps/:appName",
            "params": [
              {
                "name": "appName",
                "value": "MyApp-iOS",
                "type": "path",
                "description": "Application name (or 'owner:appName' for disambiguation)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates app properties (requires Owner permission)"
        },
        {
          "info": {
            "name": "Delete app",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://localhost:3000/apps/:appName",
            "headers": [
              {
                "name": "tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "appName",
                "value": "MyApp-iOS",
                "type": "path",
                "description": "Application name (or 'owner:appName' for disambiguation)"
              }
            ]
          },
          "docs": "Removes an app and all its deployments (requires Owner permission)"
        },
        {
          "info": {
            "name": "Transfer app ownership",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:3000/apps/:appName/transfer/:email",
            "headers": [
              {
                "name": "tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "appName",
                "value": "MyApp-iOS",
                "type": "path",
                "description": "Application name (or 'owner:appName' for disambiguation)"
              },
              {
                "name": "email",
                "value": "",
                "type": "path",
                "description": "Email of the new owner"
              }
            ]
          },
          "docs": "Transfers app ownership to another user (requires Owner permission)"
        },
        {
          "info": {
            "name": "List collaborators for an app",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:3000/apps/:appName/collaborators",
            "params": [
              {
                "name": "appName",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
