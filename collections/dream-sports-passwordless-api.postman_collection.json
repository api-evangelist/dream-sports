          "name": "Initiate the passwordless flow",
          "request": {
            "name": "Initiate the passwordless flow",
            "description": {
              "content": "API to signin, signup or signinup a user using passwordless flows. Currently only otp based passwordless flow is supported.\n\nThe first time this API is called, a unique state is returned in the response. Every subsequent request to init (to resend otp), must include the state parameter in the request, otherwise it is treated as a fresh request.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "passwordless",
                "init"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) tenant-id of the client integrating with guardian",
                "key": "tenant-id",
                "value": "<string>"
              },
