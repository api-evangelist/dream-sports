          "name": "Generate new RSA key pair",
          "request": {
            "name": "Generate new RSA key pair",
            "description": {
              "content": "Generate a new RSA key pair for token signing. The new key will be used\nfor signing new tokens while the old key remains valid for verification.\n\n**Security:** This operation should be performed periodically to rotate keys.\nThe old key will be kept for a grace period to verify existing tokens.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "keys",
                "generate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) tenant-id of the client integrating with guardian",
                "key": "tenant-id",
                "value": "<string>"
              },
